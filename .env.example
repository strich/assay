# assay configuration. Copy to .env for local use; never commit .env.
# Blank means unset, everywhere, at read time.

# --- model tiers (fully-qualified opencode model strings) -------------------
# ASSAY_MODEL_BUDGET=openrouter/deepseek/deepseek-v4-flash-0731
# ASSAY_MODEL_MID=openrouter/deepseek/deepseek-v4-flash-0731
# ASSAY_MODEL_PREMIUM=openrouter/deepseek/deepseek-v4-flash-0731

# --- LLM seam ---------------------------------------------------------------
# ASSAY_OPENCODE_BIN=opencode
# ASSAY_SCHEMA_RETRIES=2
# ASSAY_TRANSIENT_RETRIES=2
# ASSAY_LLM_TIMEOUT_SECONDS=1800

# --- budget (enforced on measured spend) ------------------------------------
# ASSAY_MAX_COST_USD=2.0
# ASSAY_MAX_DURATION_SECONDS=3600

# --- git / workspace --------------------------------------------------------
# ASSAY_GIT_TIMEOUT_SECONDS=600
# ASSAY_SKIP_GIT_LFS=1
# ASSAY_WORKDIR=/tmp/assay-work

# --- review knobs -----------------------------------------------------------
# ASSAY_EVIDENCE_PACK=1
# ASSAY_POSTWORTHINESS_GATE=0

# --- credentials ------------------------------------------------------------
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GH_TOKEN=
